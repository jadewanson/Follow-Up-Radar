APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-local-secret
APP_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://followup:replace-with-a-local-password@127.0.0.1:5432/followup_radar
REDIS_URL=redis://127.0.0.1:6379/0
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_DAYS=30
REMINDER_MAX_ATTEMPTS=3
DAILY_DIGEST_HOUR_UTC=7

# Development mail: messages are appended to this gitignored local file.
EMAIL_DELIVERY_MODE=dev_file
EMAIL_FROM_ADDRESS=noreply@followup-radar.local
DEV_EMAIL_OUTBOX_PATH=../var/dev_email_outbox

# Real mail: switch EMAIL_DELIVERY_MODE to smtp and configure the relay.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=replace-with-smtp-username
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_TIMEOUT_SECONDS=10

CORS_ALLOWED_ORIGINS=http://localhost:5173
SUPPORT_EMAIL_ADDRESS=support@followup-radar.local
BETA_TRIAL_DAYS=14
PRO_MONTHLY_PRICE_USD=9
